10 DIM F$(8191):A=ADR(F$):F$(1)=CHR$(0):F$(8191)=CHR$(0):F$(2)=F$
20 T0=PEEK(18)*65536+PEEK(19)*256+PEEK(20)
30 C=0:FOR I=0 TO 8190:IF PEEK(A+I) THEN 70
40 P=I+I+3:IF I+P>8190 THEN 60
50 FOR K=I+P TO 8190 STEP P:POKE A+K,1:NEXT K
60 C=C+1
70 NEXT I
9000 T1=PEEK(18)*65536+PEEK(19)*256+PEEK(20)
9010 U=PEEK(144)+256*PEEK(145)-PEEK(128)-256*PEEK(129):F=FRE(0)
9020 OPEN #1,8,0,"H:R.TXT":PRINT #1;C;" ";T1-T0;" ";F;" ";U:CLOSE #1:END
