10 DIM A(199):X=1:FOR I=0 TO 199:X=X*21+7:X=X-INT(X/1000)*1000:A(I)=X:NEXT I
20 T0=PEEK(18)*65536+PEEK(19)*256+PEEK(20)
30 FOR I=198 TO 0 STEP -1:FOR J=0 TO I
40 IF A(J)>A(J+1) THEN T=A(J):A(J)=A(J+1):A(J+1)=T
50 NEXT J:NEXT I
60 C=0:FOR I=0 TO 198:IF A(I)>A(I+1) THEN C=C+1
70 NEXT I:C=C*10000+A(0)*1000+A(199)
9000 T1=PEEK(18)*65536+PEEK(19)*256+PEEK(20)
9010 U=PEEK(144)+256*PEEK(145)-PEEK(128)-256*PEEK(129):F=FRE(0)
9020 OPEN #1,8,0,"H:R.TXT":PRINT #1;C;" ";T1-T0;" ";F;" ";U:CLOSE #1:END
