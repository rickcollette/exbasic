10 T0=PEEK(18)*65536+PEEK(19)*256+PEEK(20)
20 S=0:R=0:FOR N=1 TO 100:A=N
30 FOR I=1 TO 10:A=SQR(A):R=R+RND(0):NEXT I
40 FOR I=1 TO 10:A=A^2:R=R+RND(0):NEXT I
50 S=S+A:NEXT N
60 C=INT(ABS(1010-S/5)*100000)
9000 T1=PEEK(18)*65536+PEEK(19)*256+PEEK(20)
9010 U=PEEK(144)+256*PEEK(145)-PEEK(128)-256*PEEK(129):F=FRE(0)
9020 OPEN #1,8,0,"H:R.TXT":PRINT #1;C;" ";T1-T0;" ";F;" ";U:CLOSE #1:END
