10 DIM S$(100):T0=PEEK(18)*65536+PEEK(19)*256+PEEK(20)
20 C=0:FOR N=1 TO 20:S$=""
30 FOR I=1 TO 100:S$(LEN(S$)+1)=CHR$(65+I-INT(I/26)*26):NEXT I
40 FOR I=1 TO LEN(S$):IF S$(I,I)="Q" THEN C=C+1
50 NEXT I:NEXT N
9000 T1=PEEK(18)*65536+PEEK(19)*256+PEEK(20)
9010 U=PEEK(144)+256*PEEK(145)-PEEK(128)-256*PEEK(129):F=FRE(0)
9020 OPEN #1,8,0,"H:R.TXT":PRINT #1;C;" ";T1-T0;" ";F;" ";U:CLOSE #1:END
